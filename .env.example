# Optional; this is the default API endpoint.
# API_BASE_URL=https://openapi.programming-hero.com/api/bazardor
# Optional for local development (SQLite is used when omitted).
# Required in production; use a persistent PostgreSQL connection string (Neon recommended).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Required in production; local development has a local-only fallback.
# BETTER_AUTH_SECRET=replace-with-a-random-secret
# Local development defaults to http://localhost:3000.
# Set this to your canonical deployed origin on Vercel (without /api/auth).
# BETTER_AUTH_URL=https://your-project.vercel.app

# Optional OAuth providers; set each client ID and secret together.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
